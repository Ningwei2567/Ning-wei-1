<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Virtual DJ Skins - Ning Wei Media</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#f4f7f9;color:#111}
header{
height:150px;
background:linear-gradient(rgba(135,206,235,.38),rgba(135,206,235,.38)),url("../../../../ning-wei.png") center/cover no-repeat;
display:flex;align-items:center;justify-content:center
}
h1{background:rgba(255,255,255,.82);padding:10px 18px;border-radius:12px;font-size:23px}
main{max-width:700px;margin:auto;padding:15px}
.search{width:100%;padding:13px;border:1px solid #ccc;border-radius:10px;font-size:16px;margin:8px 0 12px}
.back{display:inline-block;color:#078;text-decoration:none;font-weight:bold;margin-bottom:5px}
.item{display:flex;align-items:center;gap:12px;background:#fff;padding:10px;margin:7px 0;border-radius:10px;text-decoration:none;color:#111;box-shadow:0 1px 4px #0002}
.num{width:35px;height:35px;min-width:35px;border-radius:50%;background:#000;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold}
</style>
</head>
<body>

<header><h1>🎚️ VIRTUAL DJ SKINS</h1></header>

<main>
<a class="back" href="../index.html">← Back to DJ Mixes</a>
<input id="search" class="search" placeholder="Search Virtual DJ skins...">
<div id="list">Loading...</div>
</main>

<script>
const API="https://api.github.com/repos/Ningwei2567/Ning-wei-1/contents/media/songs/DJ-Mixes/Virtual-DJ-Skins";
const list=document.getElementById("list");
const search=document.getElementById("search");
let items=[];

async function load(){
 try{
  const r=await fetch(API);
  if(!r.ok)throw new Error();
  items=await r.json();
  render();
 }catch(e){
  list.innerHTML="<p>Unable to load Virtual DJ Skins.</p>";
 }
}

function render(){
 const q=search.value.toLowerCase();
 const data=items.filter(x=>x.name.toLowerCase().includes(q));
 list.innerHTML="";

 data.forEach((item,i)=>{
  const a=document.createElement("a");
  a.className="item";

  if(item.type==="dir"){
   a.href="../browser.html?path="+encodeURIComponent(item.path);
  }else{
   a.href="../../../../media.html?path="+encodeURIComponent(item.path);
  }

  a.innerHTML=`<span class="num">${i+1}</span><span>${item.name}</span>`;
  list.appendChild(a);
 });
}

search.addEventListener("input",render);
load();
</script>

</body>
</html>
