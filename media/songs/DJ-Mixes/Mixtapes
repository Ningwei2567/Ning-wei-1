<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mixtapes - Ning Wei Media</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#f4f7f9;
}
header{
 height:150px;
 background:
 linear-gradient(rgba(135,206,235,.38),rgba(135,206,235,.38)),
 url("../../../../ning-wei.png") center/cover no-repeat;
 display:flex;
 align-items:center;
 justify-content:center;
}
header h1{
 background:rgba(255,255,255,.8);
 padding:10px 18px;
 border-radius:12px;
}
.container{
 max-width:700px;
 margin:auto;
 padding:15px;
}
.search{
 width:100%;
 padding:13px;
 border:1px solid #ccc;
 border-radius:10px;
 margin-bottom:12px;
 font-size:16px;
}
.back{
 display:inline-block;
 margin-bottom:12px;
 text-decoration:none;
 color:#078;
 font-weight:bold;
}
.item{
 display:flex;
 align-items:center;
 gap:12px;
 padding:10px;
 margin:7px 0;
 background:#fff;
 border-radius:10px;
 text-decoration:none;
 color:#111;
 box-shadow:0 1px 4px rgba(0,0,0,.12);
}
.num{
 width:35px;
 height:35px;
 min-width:35px;
 border-radius:50%;
 background:#000;
 color:#fff;
 display:flex;
 align-items:center;
 justify-content:center;
 font-weight:bold;
}
</style>
</head>

<body>

<header>
<h1>🎵 MIXTAPES / NONSTOP</h1>
</header>

<div class="container">

<a class="back" href="../index.html">← Back to DJ Mixes</a>

<input id="search" class="search" placeholder="Search mixtapes...">

<div id="list">Loading...</div>

</div>

<script>

const API=
"https://api.github.com/repos/Ningwei2567/Ning-wei-1/contents/media/songs/DJ-Mixes/Mixtapes-Nonstop";

let items=[];

const list=document.getElementById("list");
const search=document.getElementById("search");

async function load(){

 const r=await fetch(API);
 items=await r.json();

 render();

}

function render(){

 const q=search.value.toLowerCase();

 const filtered=items.filter(x=>
   x.name.toLowerCase().includes(q)
 );

 list.innerHTML="";

 filtered.forEach((item,index)=>{

   const a=document.createElement("a");

   a.className="item";

   a.href="../../../media.html?path="+encodeURIComponent(item.path);

   a.innerHTML=`
     <span class="num">${index+1}</span>
     <span>${item.name}</span>
   `;

   list.appendChild(a);

 });

}

search.addEventListener("input",render);

load();

</script>

</body>
</html>
